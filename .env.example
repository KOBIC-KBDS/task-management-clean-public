# Copy to .env.local for one clean deployment. Do not commit .env.local.
# If you prefer a screenshot/checklist workflow, copy
# ops/local_env_markdown_template.md to .env.local.md and paste values there.
# Do not commit .env.local.md.
#
# The CLI automatically loads .env.local and then .env.local.md from the current
# working directory. Blank values intentionally clear inherited shell values,
# which prevents a clean demo install from reusing tokens from another
# operational machine.
TASK_CORE_PATH=
TASK_MANAGEMENT_STATE=.task-management-demo
TASK_MANAGEMENT_DASHBOARD_URL=http://127.0.0.1:8787/dashboard.html
TASK_MANAGEMENT_SLACK_ACTOR_ID=me

# Use one local login-session backend. Claude Code is the default clean-demo
# example; switch to codex after running codex login if preferred.
TASK_MANAGEMENT_OPERATING_AGENT=claude
TASK_MANAGEMENT_CLAUDE_MODEL=sonnet
TASK_MANAGEMENT_CLAUDE_TIMEOUT_SECONDS=180
TASK_MANAGEMENT_CLAUDE_FALLBACK=0
TASK_MANAGEMENT_CLAUDE_PERMISSION_MODE=plan
TASK_MANAGEMENT_CLAUDE_MAX_TURNS=3
TASK_MANAGEMENT_CLAUDE_STRIP_API_KEY_ENV=1
TASK_MANAGEMENT_CODEX_MODEL=gpt-5.5

# Instance guard: live sends are allowed only when both IDs match.
# Change both to a unique name for this clean install.
TASK_MANAGEMENT_INSTANCE_ID=clean-demo
TASK_MANAGEMENT_ALLOWED_INSTANCE_ID=clean-demo

# Fill these from a NEW Slack app/workspace installation.
# Leave blank until the new app is installed.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_USER_ID=
SLACK_DM_CHANNEL_ID=
SLACK_BOT_USER_ID=
TASK_MANAGEMENT_SLACK_WATCH_CHANNEL_IDS=
TASK_MANAGEMENT_SLACK_WATCH_REQUIRE_MENTION=1
