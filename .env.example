# Copy to .env or set as user/process environment variables. Do not commit secrets.
TASK_CORE_PATH=/path/to/task-core
TASK_MANAGEMENT_OPERATING_AGENT=codex
TASK_MANAGEMENT_CODEX_MODEL=gpt-5.5
# To use Claude Code instead, set TASK_MANAGEMENT_OPERATING_AGENT=claude
# after logging in with the local Claude Code CLI.
TASK_MANAGEMENT_CLAUDE_MODEL=sonnet
TASK_MANAGEMENT_CLAUDE_TIMEOUT_SECONDS=180
TASK_MANAGEMENT_CLAUDE_FALLBACK=0
TASK_MANAGEMENT_CLAUDE_PERMISSION_MODE=plan
TASK_MANAGEMENT_CLAUDE_MAX_TURNS=3
TASK_MANAGEMENT_CLAUDE_STRIP_API_KEY_ENV=1
TASK_MANAGEMENT_STATE=.task-management-demo
TASK_MANAGEMENT_DASHBOARD_URL=http://127.0.0.1:8787/dashboard.html
TASK_MANAGEMENT_SLACK_ACTOR_ID=me
SLACK_BOT_TOKEN=xoxb-test
SLACK_APP_TOKEN=xapp-test
SLACK_USER_ID=U...
SLACK_DM_CHANNEL_ID=
SLACK_BOT_USER_ID=
TASK_MANAGEMENT_SLACK_WATCH_CHANNEL_IDS=
TASK_MANAGEMENT_SLACK_WATCH_REQUIRE_MENTION=1
