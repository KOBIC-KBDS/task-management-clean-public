<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.task-management.dashboard-http</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/task-management/.venv/bin/python</string>
    <string>-X</string>
    <string>utf8</string>
    <string>-m</string>
    <string>http.server</string>
    <string>8787</string>
    <string>--bind</string>
    <string>127.0.0.1</string>
    <string>--directory</string>
    <string>/opt/task-management/out/live</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/opt/task-management</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/opt/task-management/.task-management-live/logs/dashboard-http.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/task-management/.task-management-live/logs/dashboard-http.launchd.err.log</string>
</dict>
</plist>
